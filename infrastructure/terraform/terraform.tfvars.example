# ==============================================================================
# HomeVerse Terraform Variables Example
# Copy to terraform.tfvars or pass via -var-file=environments/<env>.tfvars
# ==============================================================================

aws_region      = "us-east-1"
environment     = "development"
project_name    = "homeverse"
vpc_cidr        = "10.0.0.0/16"

# RDS Configuration
db_instance_class    = "db.t4g.micro"
db_allocated_storage = 20
db_name              = "homeverse"
db_username          = "homeverse_admin"
db_password          = "YourSuperSecretPasswordHere2026!"

# ECS Fargate Sizing
backend_cpu            = 256
backend_memory         = 512
frontend_cpu           = 256
frontend_memory        = 512
backend_desired_count  = 1
frontend_desired_count = 1

# CloudFront CDN
enable_cloudfront = true
