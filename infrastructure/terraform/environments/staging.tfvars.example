# ==============================================================================
# Staging Environment Terraform Variables (Phase 35)
# ==============================================================================
aws_region      = "us-east-1"
environment     = "staging"
project_name    = "homeverse"
vpc_cidr        = "10.1.0.0/16"

# RDS Configuration (Mirroring production topology)
db_instance_class    = "db.t4g.small"
db_allocated_storage = 30
db_name              = "homeverse"
db_username          = "homeverse_staging"
db_password          = "ChangeMeStagingPass2026!"

# ECS Fargate Sizing (Dual replicas for high-availability testing)
backend_cpu            = 512
backend_memory         = 1024
frontend_cpu           = 512
frontend_memory        = 1024
backend_desired_count  = 2
frontend_desired_count = 2

enable_cloudfront = true
