# ==============================================================================
# Production Environment (AWS Multi-AZ Production Cluster)
# ==============================================================================
ENVIRONMENT=production
PROJECT_NAME=HomeVerse

# Managed AWS RDS PostgreSQL Multi-AZ (Production)
DATABASE_URL=postgresql://homeverse_prod:ProdSecretPassword2026@homeverse-db-production.c7...us-east-1.rds.amazonaws.com:5432/homeverse

# Managed AWS ElastiCache Redis Cluster (Production)
REDIS_URL=redis://homeverse-redis-production.c7...us-east-1.cache.amazonaws.com:6379/0
CELERY_BROKER_URL=redis://homeverse-redis-production.c7...us-east-1.cache.amazonaws.com:6379/1
CELERY_RESULT_BACKEND=redis://homeverse-redis-production.c7...us-east-1.cache.amazonaws.com:6379/2

# Production Secrets (Retrieved from AWS Secrets Manager)
JWT_SECRET=production-cryptographically-random-256-bit-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AWS Production Infrastructure
AWS_REGION=us-east-1
AWS_BUCKET_NAME=homeverse-uploads-production
AWS_ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com

# Production AI Engine Keys
AI_API_KEY=sk-prod-primary-ai-key

# Production Custom Domain
NEXT_PUBLIC_API_URL=https://api.homeverse.ai
NEXT_PUBLIC_ENVIRONMENT=production
