# ==============================================================================
# Development Environment (Local Docker / Local Machine)
# ==============================================================================
ENVIRONMENT=development
PROJECT_NAME=HomeVerse

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/homeverse
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

JWT_SECRET=dev-only-insecure-secret-key-32-chars-long-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

AWS_REGION=us-east-1
AWS_BUCKET_NAME=homeverse-uploads-development

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_ENVIRONMENT=development
