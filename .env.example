# ==============================================================================
# HomeVerse — AI Interior Design & Budget Planning Platform
# Environment Configuration Template
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="HomeVerse AI Interior Designer"
API_V1_STR="/api"

# Security & Authentication
SECRET_KEY=change-this-to-a-super-secret-hex-encoded-jwt-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=homeverse
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/homeverse

# Redis & Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Celery Background Worker
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Object Storage / AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=homeverse-uploads

# AI Providers & Keys
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key
REPLICATE_API_TOKEN=your-replicate-api-token

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080"]
