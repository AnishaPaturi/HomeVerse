# ==============================================================================
# HomeVerse Environment Configuration Template (Phase 29 & Phase 35)
# NEVER COMMIT ACTUAL SECRETS TO SOURCE CONTROL
# ==============================================================================

# Environment: development | staging | production
ENVIRONMENT=development
PROJECT_NAME=HomeVerse

# -------------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/homeverse

# -------------------------------------------------------------
# Cache & Task Queue (Redis)
# -------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -------------------------------------------------------------
# Security & JWT Authentication
# -------------------------------------------------------------
JWT_SECRET=replace-with-a-secure-random-256-bit-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -------------------------------------------------------------
# AWS Cloud Infrastructure & Object Storage (S3)
# -------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=homeverse-uploads-development
AWS_ECR_REGISTRY=

# -------------------------------------------------------------
# AI Engine Credentials
# -------------------------------------------------------------
AI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# -------------------------------------------------------------
# Frontend Application
# -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_ENVIRONMENT=development
