# ==============================================================================
# Staging Environment (AWS Staging Cluster)
# ==============================================================================
ENVIRONMENT=staging
PROJECT_NAME=HomeVerse

# Managed AWS RDS PostgreSQL (Staging)
DATABASE_URL=postgresql://homeverse_staging:StagingSecretPassword2026@homeverse-db-staging.c7...us-east-1.rds.amazonaws.com:5432/homeverse

# Managed AWS ElastiCache Redis (Staging)
REDIS_URL=redis://homeverse-redis-staging.c7...us-east-1.cache.amazonaws.com:6379/0
CELERY_BROKER_URL=redis://homeverse-redis-staging.c7...us-east-1.cache.amazonaws.com:6379/1
CELERY_RESULT_BACKEND=redis://homeverse-redis-staging.c7...us-east-1.cache.amazonaws.com:6379/2

# Production-grade staging JWT secret
JWT_SECRET=staging-secret-key-must-be-rotated-regularly-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AWS Resources
AWS_REGION=us-east-1
AWS_BUCKET_NAME=homeverse-uploads-staging
AWS_ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com

# AI API Credentials
AI_API_KEY=sk-staging-ai-key

# Staging Frontend URL
NEXT_PUBLIC_API_URL=https://api-staging.homeverse.ai
NEXT_PUBLIC_ENVIRONMENT=staging
